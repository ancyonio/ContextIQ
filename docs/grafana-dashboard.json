        {
          "expr": "contextiq_reduction_ratio",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Cost avoided",
      "datasource": {
        "type": "prometheus",
