# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Packaging / build outputs
build/
dist/
*.egg-info/
*.spec
*.vsix

# Environment
.venv/
env/
venv/
ENV/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# tokengraph runtime state (rebuildable caches / local ledgers)
.tokengraph/
.context/

# Generated editor plugin scaffolds (produced by `ide-plugin`)
ide-plugins/

# IDEs
.vscode/
!.vscode/mcp.json
.idea/

# OS
.DS_Store
Thumbs.db

# Benchmark fixture repos are source-only; their generated graphs are not.
benchmarks/repos/*/.tokengraph/
benchmarks/repos/**/__pycache__/
benchmark.json
